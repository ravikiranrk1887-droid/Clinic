{
  "name": "clinicqueue-lite-server",
  "version": "1.0.0",
  "description": "ClinicQueue Lite - Backend API Server",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
